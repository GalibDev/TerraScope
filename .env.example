# Server-only Earthdata credentials. Never commit .env.local.
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
# Optional OpenAI assistant. Without a key, a scientific reference explanation is provided.
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=gpt-4.1-mini
# Optional normalized, provenance-bearing MODIS JSON file on the server.
VEGETATION_DATA_PATH=
# Optional public HTTPS normalized dataset (read-only, cached for 1 hour).
# Otherwise data/vegetation.json is bundled when present.
VEGETATION_DATA_URL=
